  <!-- Premium Interactivity Link Redirection Popup Overlay -->
  <div 
    id="redirect-overlay" 
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-5 opacity-0 pointer-events-none"
  >
    <div class="bg-slate-900 border border-slate-800 text-white rounded-2xl max-w-sm w-full p-6 text-center space-y-5 shadow-2xl relative overflow-hidden">
      <!-- Glow ambient bar -->
      <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-cyan-400 via-indigo-500 to-pink-500"></div>
      
      <!-- Target product thumb display -->
      <div class="relative w-16 h-16 mx-auto rounded-xl overflow-hidden bg-slate-800 shadow-lg">
        <img id="redirect-thumb" src="" alt="Thumbnail" class="w-full h-full object-cover" />
      </div>

      <div class="space-y-1.5">
        <h4 id="redirect-title" class="text-sm font-bold truncate px-3">...</h4>
        <p id="redirect-loader-msg" class="text-xs text-slate-400">Đang chuẩn bị liên kết tiếp thị an toàn...</p>
      </div>

      <!-- Responsive animated linear countdown load-bar -->
      <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div id="redirect-progress-bar" class="bg-gradient-to-r from-cyan-400 via-indigo-500 to-pink-500 h-full w-0 transition-all duration-1000 ease-linear"></div>
      </div>

      <div class="flex items-center justify-center gap-2 text-[10px] text-slate-500 font-semibold font-mono">
        <svg class="w-3.5 h-3.5 animate-spin" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 4H20" /></svg>
        <span>Vui lòng chờ giây lát...</span>
      </div>
    </div>
  </div>

  <!-- Dynamic Controller Interactivity Engine script -->
  <script>
    const isDarkTheme = true;

    // 1. Dynamic category pill routing / filter handler
    const categoryPills = document.querySelectorAll('.category-pill');
    const productCards = document.querySelectorAll('.product-card');

    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const selectedCat = pill.getAttribute('data-cat-pill');
        
        // Update active class styles for all pills
        categoryPills.forEach(p => {
          p.classList.remove('bg-white', 'text-slate-950', 'bg-slate-900', 'text-white', 'shadow-md', 'font-extrabold');
          
          if (isDarkTheme) {
            p.classList.add('bg-white/5', 'border-white/5', 'text-slate-300');
          } else {
            p.classList.add('bg-slate-100', 'border-slate-200/50', 'text-slate-600');
          }
        });

        // Set active state on clicked pill
        if (isDarkTheme) {
          pill.classList.remove('bg-white/5', 'border-white/5', 'text-slate-300');
          pill.classList.add('bg-white', 'text-slate-950', 'shadow-md', 'font-extrabold');
        } else {
          pill.classList.remove('bg-slate-100', 'border-slate-200/50', 'text-slate-600');
          pill.classList.add('bg-slate-900', 'text-white', 'shadow-md', 'font-extrabold');
        }

        // Show/Hide matching product cards
        productCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'tất cả' || cardCat === selectedCat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 2. Beautiful redirect loader popup overlay handlers
    const redirectOverlay = document.getElementById('redirect-overlay');
    const redirectThumb = document.getElementById('redirect-thumb');
    const redirectTitle = document.getElementById('redirect-title');
    const redirectProgressBar = document.getElementById('redirect-progress-bar');
    const redirectLoadMsg = document.getElementById('redirect-loader-msg');

    productCards.forEach(card => {
      card.addEventListener('click', () => {
        const targetUrl = card.getAttribute('data-url');
        const targetTitle = card.getAttribute('data-title');
        const targetThumb = card.getAttribute('data-thumb');

        if (!targetUrl) return;

        // Populate and open overlay
        redirectThumb.src = targetThumb;
        redirectTitle.textContent = targetTitle;
        
        const platform = targetUrl.includes('shopee') ? 'Shopee' : targetUrl.includes('lazada') ? 'Lazada' : 'cửa hàng';
        redirectLoadMsg.innerHTML = 'Đang chuyển hướng an toàn tới <b class="text-rose-400">' + platform + '</b>...';

        // Trigger transition opening
        redirectOverlay.classList.remove('pointer-events-none');
        redirectOverlay.classList.remove('opacity-0');
        redirectOverlay.classList.add('opacity-100');

        // Animate progress bar loader fill to 100%
        setTimeout(() => {
          redirectProgressBar.style.width = '100%';
        }, 50);

        // Complete redirection after timeout countdown ticks
        setTimeout(() => {
          window.location.href = targetUrl;
        }, 1200);
      });
    });
  </script>
</body>
</html>
